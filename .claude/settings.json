{
  "permissions": {
    "deny": [
      "Read(~/.config/mooapp/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(* --env real*)",
      "Bash(*--env=real*)"
    ],
    "ask": [
      "Bash(git push *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-real.sh\""
          }
        ]
      }
    ]
  }
}
